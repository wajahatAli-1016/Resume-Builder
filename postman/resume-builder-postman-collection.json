    {
      "name": "Resume",
      "item": [
        {
          "name": "Create Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson.resume && responseJson.resume._id) {",
                  "  pm.environment.set(\"resumeId\", responseJson.resume._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Software Engineer Resume\",\n  \"personalInfo\": {\n    \"fullName\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"phone\": \"+1-111-222-3333\",\n    \"address\": \"123 Main Street, San Francisco, CA 94105\"\n  },\n  \"education\": [\n    {\n      \"school\": \"XYZ University\",\n      \"degree\": \"BS Computer Science\",\n      \"startDate\": \"2019-09-01\",\n      \"endDate\": \"2023-06-01\",\n      \"description\": \"Graduated with honors\"\n    }\n  ],\n  \"experience\": [\n    {\n      \"company\": \"ABC Tech\",\n      \"role\": \"Frontend Developer\",\n      \"startDate\": \"2023-07-01\",\n      \"endDate\": \"2025-03-01\",\n      \"description\": \"Built reusable UI components\"\n    }\n  ],\n  \"skills\": [\"JavaScript\", \"React\", \"Node.js\", \"MongoDB\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/resume",
